bin/
*.tmp
/tmp/

# MCPB bundle build output (cross-compiled binaries + packed .mcpb). Generated
# by `make mcpb`; the manifest template + launcher under packaging/mcpb/ are the
# only committed sources. Never commit the built binaries or the .mcpb archive.
/packaging/mcpb/dist/
**/.DS_Store
.idea/
*.swp

# Integration-test SSH keys are generated at test time and deleted on teardown.
# NEVER commit them — this repo mirrors to public GitHub. Keep only .gitkeep.
/tests/integration/fixtures/keys/*
!/tests/integration/fixtures/keys/.gitkeep

# gate-redteam standing-target artifacts (state file, stable key dir) and
# campaign reports. Generated at runtime; never commit (the key dir holds a
# live SSH private key, the report can be large).
/.gate-redteam*
gate-redteam-report*.jsonl

# Scratch/junk dir for throwaway artifacts (e.g. red-team hunt findings/ideas
# dumps, stray binaries). Never committed.
/junk/

# Claude Code local scratch: subagent git worktrees, session-local settings.
# Never committed (worktrees contain a full repo checkout + live .git pointers).
/.claude/

# Local operator workspace: migration playbooks, per-server inventories, run
# logs, and any other operational notes about the operator's own machines. NEVER
# committed (this repo mirrors to public GitHub and these hold infra specifics).
/local-workspace/

# Operator-local agent context and notes. NEVER committed (this repo is public).
CLAUDE.local.md
/local-notes/
